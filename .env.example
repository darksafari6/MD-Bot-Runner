# ---------------------------------------------------------------------------
# WhatsApp MD Bot Runner Manager (Python) — copy to .env and adjust.
# ---------------------------------------------------------------------------

# Web panel
HOST=127.0.0.1
PORT=8080
# Require a bearer token on every /api call. Set this before exposing the port.
# API_TOKEN=change-me

# Data location (SQLite database + WhatsApp session credentials)
# WAMANAGER_DATA_DIR=./data
MAX_INSTANCES=10
LOG_LEVEL=INFO

# AI provider — any OpenAI-compatible endpoint.
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://127.0.0.1:11434/v1   (no key needed for local endpoints)
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60

# Baileys/whatsmeow is unofficial. Use a dedicated number.
