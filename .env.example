# ---------------------------------------------------------------------------
# WhatsApp MD Bot Runner Manager — environment
# Copy to .env and adjust. Every value is optional.
# ---------------------------------------------------------------------------

# Port for the API + built UI (one process in production).
PORT=3001

# Bind address. Use 127.0.0.1 to keep the panel off the network entirely.
HOST=0.0.0.0

# Where WhatsApp credentials and state.json live.
# WAMANAGER_DATA_DIR=./data

# Require auth on every /api request. The dashboard asks for this token once
# and remembers it in the browser. Leave empty ONLY for loopback-only setups.
# API_TOKEN=change-me

# Maximum concurrent WhatsApp sockets this process will run.
MAX_INSTANCES=10

# In-memory log ring size and manager verbosity (debug|info|warn|error).
LOG_BUFFER=2000
LOG_LEVEL=info

# Baileys' own logging: silent | error | warn | info | debug | trace
BAILEYS_LOG_LEVEL=silent

# Extra browser origins allowed to call the API (comma separated).
# CORS_ORIGINS=https://panel.example.com
