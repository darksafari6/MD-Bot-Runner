{
  "name": "whatsapp-md-bot-runner-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted control panel for running multiple WhatsApp Multi-Device bot instances on Baileys.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{src,server,shared,test,scripts}/**/*.{ts,tsx,mjs,css}\"",
    "format:check": "prettier --check \"{src,server,shared,test,scripts}/**/*.{ts,tsx,mjs,css}\"",
    "desktop": "electron .",
    "clean": "rm -rf dist dist-server"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.3.5",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "electron": "^33.2.1"
  }
}
